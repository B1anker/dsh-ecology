{
  "name": "@seaveyon/dsh-di",
  "version": "0.1.0",
  "description": "A small VS Code-style dependency injection container for dsh plugins: service identifiers, constructor injection, lazy singletons, child scopes and disposal",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "dependency-injection",
    "di",
    "ioc",
    "instantiation",
    "services"
  ],
  "license": "MIT",
  "author": "B1anker",
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/B1anker/dsh-ecology.git",
    "directory": "packages/di"
  },
  "homepage": "https://github.com/B1anker/dsh-ecology/tree/main/packages/di#readme",
  "bugs": {
    "url": "https://github.com/B1anker/dsh-ecology/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rslib build",
    "dev": "rslib build --watch",
    "test": "rslib build && rstest run",
    "test:unit": "rstest run",
    "test:coverage": "rstest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pack:check": "bun run build && npm pack --dry-run"
  },
  "devDependencies": {
    "@rslib/core": "^0.23.2",
    "@rstest/core": "^0.11.9",
    "@rstest/coverage-v8": "^0.11.9",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  }
}
