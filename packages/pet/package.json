{
  "name": "@seaveyon/dsh-pet",
  "version": "0.1.0",
  "description": "A virtual pet companion for the DSH Web surface: mood animations driven by live agent state, with hand-crafted built-in sprites",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "pet",
    "companion",
    "overlay",
    "web-ui"
  ],
  "license": "MIT",
  "author": "B1anker",
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "default": "./dist/client.js"
    },
    "./desktop": {
      "types": "./dist/desktop.d.ts",
      "default": "./dist/desktop.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "desktop/",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [],
      "immediately": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/B1anker/dsh-ecology.git",
    "directory": "packages/pet"
  },
  "homepage": "https://github.com/B1anker/dsh-ecology/tree/main/packages/pet#readme",
  "bugs": {
    "url": "https://github.com/B1anker/dsh-ecology/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rslib build",
    "dev": "rslib build --watch",
    "test": "rslib build && rstest run",
    "test:unit": "rstest run",
    "test:coverage": "rstest run --coverage",
    "test:watch": "rstest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pack:check": "bun run build && npm pack --dry-run",
    "build:desktop": "cd ../pet-desktop && zig build -Doptimize=ReleaseSmall --prefix zig-out-arm64 && zig build -Doptimize=ReleaseSmall -Dtarget=x86_64-macos --prefix zig-out-x64 && zig build -Doptimize=ReleaseSmall -Dtarget=x86_64-windows-gnu --prefix zig-out-win-x64 && mkdir -p ../pet/desktop && install -m 755 zig-out-arm64/bin/dsh-pet-desktop ../pet/desktop/dsh-pet-desktop-arm64 && install -m 755 zig-out-x64/bin/dsh-pet-desktop ../pet/desktop/dsh-pet-desktop-x64 && install -m 755 zig-out-win-x64/bin/dsh-pet-desktop.exe ../pet/desktop/dsh-pet-desktop-windows-x64.exe && rm -rf ../pet/desktop/assets && cp -R assets ../pet/desktop/assets"
  },
  "devDependencies": {
    "@rsbuild/plugin-react": "^1",
    "@rslib/core": "^0.23.2",
    "@rstest/core": "^0.11.9",
    "@rstest/coverage-v8": "^0.11.9",
    "@seaveyon/dsh-plugin-testkit": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^26.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.9.3"
  }
}
