{
  "name": "@seaveyon/dsh-web-login",
  "version": "0.3.0",
  "description": "Cookie-session login gate for the dsh Web surface, with optional GitHub OAuth identity",
  "keywords": [
    "dsh",
    "cordis",
    "authentication",
    "login",
    "session",
    "github",
    "oauth",
    "reverse-proxy"
  ],
  "license": "MIT",
  "author": "B1anker",
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-web-login-hash": "./dist/hash-password.js",
    "dsh-web-login-recovery": "./dist/create-recovery.js"
  },
  "files": [
    "dist/",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/B1anker/dsh-ecology.git",
    "directory": "packages/web-login"
  },
  "homepage": "https://github.com/B1anker/dsh-ecology/tree/main/packages/web-login#readme",
  "bugs": {
    "url": "https://github.com/B1anker/dsh-ecology/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.7"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    }
  },
  "scripts": {
    "build": "rslib build",
    "dev": "rslib build --watch",
    "test": "rslib build && rstest run",
    "test:unit": "rstest run",
    "test:real-host": "rstest run test/integration/real-host-login-gate.test.ts",
    "test:coverage": "rstest run --coverage",
    "test:watch": "rstest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pack:check": "bun run build && npm pack --dry-run"
  },
  "devDependencies": {
    "@rslib/core": "^0.23.2",
    "@rstest/core": "^0.11.9",
    "@rstest/coverage-v8": "^0.11.9",
    "@seaveyon/dsh-plugin-testkit": "workspace:*",
    "@types/node": "^24.0.0",
    "fast-check": "^4.9.0",
    "typescript": "^5.9.3"
  }
}
