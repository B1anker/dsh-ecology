{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Emit-targeting module settings: the published artifact is plain Node ESM
    // compiled with tsc (this package is a standalone CLI, not a rslib bundle),
    // so relative imports carry explicit .js extensions as NodeNext requires.
    // The tsconfig.base bundler resolution is fine for rslib consumers but
    // would emit extensionless imports that Node cannot load.
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "noEmit": true,
    "jsx": "react-jsx",
    // The container is a workspace sibling; typecheck against its source so
    // build order does not decide whether this package typechecks.
    // tsconfig.build.json resets `paths` so the emitted output resolves the
    // bare specifier through node_modules, as a consumer's Node will.
    "paths": {
      "@seaveyon/dsh-di": ["../di/src/index.ts"],
      "@seaveyon/dsh-di/host": ["../di/src/host.ts"]
    }
  },
  "include": ["src", "test", "rstest.config.ts"]
}
