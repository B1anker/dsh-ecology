{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "./dist",
    "rootDir": "./src",
    // No source or declaration maps: the Node side is a CLI and a host plugin
    // nobody steps through from a consumer's editor, and the 210 map files
    // were half the published file count. Same footprint as the other packages.
    "declarationMap": false,
    "sourceMap": false,
    "lib": ["ES2023", "DOM"]
  },
  "include": ["src"],
  "exclude": ["src/client"]
}
