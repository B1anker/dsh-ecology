{
  "name": "@seaveyon/dsh-plugin-testkit",
  "version": "0.4.0",
  "description": "Test doubles and conformance suites for dsh Cordis plugins (webServer, context events, tools pipeline)",
  "keywords": [
    "dsh",
    "cordis",
    "testing",
    "mock",
    "contract-testing",
    "waterfall",
    "tools"
  ],
  "license": "MIT",
  "author": "B1anker",
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./contract": {
      "types": "./dist/contract.d.ts",
      "default": "./dist/contract.js"
    },
    "./contract/core": {
      "types": "./dist/contract/core.d.ts",
      "default": "./dist/contract/core.js"
    },
    "./real": {
      "types": "./dist/real.d.ts",
      "default": "./dist/real.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/B1anker/dsh-ecology.git",
    "directory": "packages/plugin-testkit"
  },
  "homepage": "https://github.com/B1anker/dsh-ecology/tree/main/packages/plugin-testkit#readme",
  "bugs": {
    "url": "https://github.com/B1anker/dsh-ecology/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@rstest/core": ">=0.11.0"
  },
  "peerDependenciesMeta": {
    "@rstest/core": {
      "optional": true
    }
  },
  "scripts": {
    "build": "rslib build",
    "dev": "rslib build --watch",
    "test": "rslib build && rstest run",
    "test:unit": "rstest run",
    "test:coverage": "rstest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pack:check": "bun run build && npm pack --dry-run"
  },
  "devDependencies": {
    "@rslib/core": "^0.23.2",
    "@rstest/core": "^0.11.9",
    "@rstest/coverage-v8": "^0.11.9",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  }
}
