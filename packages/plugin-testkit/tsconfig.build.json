{
  // Declaration emit only. `tsconfig.json` deliberately includes the tests and
  // the two config files so `typecheck` covers them, but that widens the common
  // root to the package directory: declarations land in `dist/src/` and the
  // configs get `.d.ts` files of their own. Narrowing to `src` puts each
  // declaration beside the `.js` it describes, which is where the `exports` map
  // says it is.
  //
  // `paths` is reset: typecheck maps `@seaveyon/dsh-di` to the sibling's
  // source, which would sit outside this `rootDir`; the build resolves it
  // through node_modules — the sibling's built declarations — the way a
  // consumer's compiler will. The workspace build runs in dependency order,
  // so they exist by the time this runs.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    "paths": {}
  },
  "include": ["src"]
}
