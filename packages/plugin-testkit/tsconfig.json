{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node"],
    "noEmit": true,
    // The container is a workspace sibling; typecheck against its source so
    // the order the packages are built in does not decide whether this one
    // typechecks. (No `rootDir` here for that reason: the sibling's sources
    // sit outside this package.) The build config resets `paths`, so emitted
    // declarations resolve the bare specifier through node_modules like a
    // consumer's compiler will.
    "paths": {
      "@seaveyon/dsh-di": ["../di/src/index.ts"],
      "@seaveyon/dsh-di/host": ["../di/src/host.ts"]
    }
  },
  "include": ["src", "test", "rslib.config.ts", "rstest.config.ts"]
}
