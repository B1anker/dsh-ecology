{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "import", "node", "promise"],
  "env": {
    "builtin": true,
    "node": true
  },
  "ignorePatterns": ["node_modules", "dist"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ]
  },
  "overrides": [
    {
      "files": ["**/*.{test,spec}.ts"],
      "env": {
        "jest": true
      }
    }
  ]
}
